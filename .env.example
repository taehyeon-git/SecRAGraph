# Reference for advanced overrides. Normal setup uses one command:
# uv run --frozen python -m scripts.local_up
# That command creates/reuses ignored build/local/runtime.env with independent
# database passwords. Keep the file with the existing postgres_data volume.
POSTGRES_DB=secragraph
POSTGRES_USER=secragraph
# The one-command local startup uses member sessions and clears operator Bearer tokens.
# Advanced deployments may configure SECRAGRAPH_API_TOKEN separately.
# Set false to keep scan-time dependency coordinates local.
SECRAGRAPH_AUTO_OSV_ENABLED=true
# Set false to disable automatic official CWE lookups during scans and questions.
SECRAGRAPH_AUTO_CWE_ENABLED=true
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=8501
QDRANT_PORT=6333
SECRAGRAPH_QDRANT_COLLECTION=secragraph-auto-cwe
SECRAGRAPH_QDRANT_VECTOR_DIMENSION=1536
# Optional calling-shell variable: enables provider-backed RAG indexing and answers.
# SECRAGRAPH_OPENAI_API_KEY=

SECRAGRAPH_ENVIRONMENT=production
SECRAGRAPH_MAX_REQUEST_BYTES=6000000
SECRAGRAPH_MAX_UPLOAD_BYTES=5000000
SECRAGRAPH_MAX_EXTRACTED_BYTES=20000000
SECRAGRAPH_MAX_ARCHIVE_FILES=500
