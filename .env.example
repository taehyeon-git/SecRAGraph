# Copy to an untracked .env and set both database passwords before Docker Compose runs.
# Generate independent URL-safe values, for example with: openssl rand -hex 32
# Existing postgres_data volumes retain their initialized passwords until roles are rotated.
POSTGRES_DB=secragraph
POSTGRES_USER=secragraph
POSTGRES_PASSWORD=
SECRAGRAPH_READER_PASSWORD=
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=8501
QDRANT_PORT=6333
SECRAGRAPH_QDRANT_COLLECTION=secragraph-security-documents
SECRAGRAPH_QDRANT_VECTOR_DIMENSION=1536
# Optional: enables provider-backed knowledge and document ingestion.
# SECRAGRAPH_OPENAI_API_KEY=

SECRAGRAPH_ENVIRONMENT=development
SECRAGRAPH_MAX_REQUEST_BYTES=6000000
SECRAGRAPH_MAX_UPLOAD_BYTES=5000000
SECRAGRAPH_MAX_EXTRACTED_BYTES=20000000
SECRAGRAPH_MAX_ARCHIVE_FILES=500
